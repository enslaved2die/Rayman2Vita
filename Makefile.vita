# ==============================================================================
# Rayman 2: The Great Escape — PS Vita Port (Dreamcast SH-4 Recompilation)
# ==============================================================================

VITASDK         ?= $(abspath .vitasdk)
CC              := $(VITASDK)/bin/arm-vita-eabi-gcc
CXX             := $(VITASDK)/bin/arm-vita-eabi-g++
VITA_ELF_CREATE := $(VITASDK)/bin/vita-elf-create
VITA_MAKE_FSELF := $(VITASDK)/bin/vita-make-fself
VITA_MKSFOEX    := $(VITASDK)/bin/vita-mksfoex
VITA_PACK_VPK   := $(VITASDK)/bin/vita-pack-vpk

TARGET          := rayman2_recomp
TITLE_ID        := RAYM00002
APP_TITLE       := "Rayman 2: The Great Escape (DC Recomp)"
APP_VER         := 01.00

BUILD_DIR       := build_vita
RECOMP_DIR      := tools/sh4recomp
HGEN            := $(RECOMP_DIR)/gen_fix
HLE_DIR         := $(RECOMP_DIR)/hle

# EXTRA_CFLAGS: e.g. EXTRA_CFLAGS=-fstack-usage to measure recompiled frame sizes.
# -ffunction-sections/--gc-sections drops unused generated functions; -fno-strict-aliasing is needed by the guest-memory casts.
# OPT: -O3 + -fno-math-errno (sqrtf -> single vsqrt.f32 instead of the errno-setting newlib wrapper). Deliberately NOT -funsafe-math-optimizations/-ffast-math: they allow
# reassociation, reciprocal-division and NEON float vectorisation (NEON ignores FPSCR RMode and always flushes), which would change the bit-exact SH-4 FPU semantics.
# OPT_HOT: flags for everything that is not cold. OPT_COLD=cold (default) marks guest functions that never ran in the profiled host scenes (re_analysis/dc/hot_funcs.txt, ~60% of the 5705
# lifted functions) with GCC's cold attribute (optimised for size, placed in .text.unlikely) via hle/coldmark.py; OPT_COLD=none compiles everything with OPT_HOT; OPT_COLD=<attribute text>
# passes that attribute instead. Whole-program variants: OPT_HOT="-Os ..." / "-O2 ...". Text sizes of the variants: re_analysis/dc/notes_perf_cpu2.md.
OPT_HOT         ?= -O3 -fno-math-errno -fomit-frame-pointer
OPT_COLD        ?= cold
OPT             ?= $(OPT_HOT)
HOT_LIST        ?= re_analysis/dc/hot_funcs.txt
ifeq ($(OPT_COLD),none)
COLD_FILTER     := cat
else ifeq ($(OPT_COLD),cold)
COLD_FILTER     := python3 $(HLE_DIR)/coldmark.py $(HOT_LIST)
else
COLD_FILTER     := python3 $(HLE_DIR)/coldmark.py $(HOT_LIST) '$(OPT_COLD)'
endif
CFLAGS          := $(OPT) -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard \
                   -fno-strict-aliasing -ffunction-sections -fdata-sections \
                   $(EXTRA_CFLAGS) \
                   -Wall -Wextra -Wno-unused-parameter -Wno-unused-variable -Wno-unused-label \
                   -DCPA_PLATFORM_VITA -DR2_DREAMCAST_BASELINE -D__vita__ \
                   -I$(RECOMP_DIR) -I$(HGEN) -I$(HLE_DIR)

LDFLAGS         := -Wl,-q -Wl,--gc-sections -L$(VITASDK)/arm-vita-eabi/lib

# PROFILE=1: per-frame split of GL submit / swap / TA SQ parse time in the [vita] log line (costs two timer reads per TA write).
ifeq ($(PROFILE),1)
CFLAGS  += -DR2_VITA_PROFILE
LDFLAGS += -Wl,--wrap,vita_gl_render_frame -Wl,--wrap,vita_gl_swap -Wl,--wrap,ta_ext_write32
endif

LIBS            := -lvitaGL \
                   -lvitashark \
                   -lSceShaccCgExt \
                   -lSceShaccCg_stub \
                   -ltaihen_stub \
                   -lSceGxm_stub \
                   -lSceDisplay_stub \
                   -lSceCtrl_stub \
                   -lSceKernelDmacMgr_stub \
                   -lSceCommonDialog_stub \
                   -lSceAppMgr_stub \
                   -lSceLibKernel_stub \
                   -lSceKernelThreadMgr_stub \
                   -lSceIofilemgr_stub \
                   -lSceAudio_stub \
                   -lScePower_stub \
                   -lmathneon \
                   -lstdc++ \
                   -lm

# Audio module (owned elsewhere): linked when present; build with SND_SRC= to leave it out.
SND_SRC         ?= $(wildcard $(HLE_DIR)/snd.c)

# Generated recompilation translation units
RECOMP_SRCS     := $(wildcard $(HGEN)/recomp_[0-9]*.c)
RECOMP_OBJS     := $(patsubst $(HGEN)/recomp_%.c,$(BUILD_DIR)/recomp_%.o,$(RECOMP_SRCS))

# HLE & Runtime Sources
HLE_SRCS        := $(HLE_DIR)/boot.c \
                   $(HLE_DIR)/dbg.c \
                   $(HLE_DIR)/io.c \
                   $(HLE_DIR)/pad.c \
                   $(HLE_DIR)/perf.c \
                   $(HLE_DIR)/ta.c \
                   $(HLE_DIR)/ta_hle.c \
                   $(SND_SRC) \
                   $(HLE_DIR)/texmap.c \
                   $(HLE_DIR)/vita_gl_render.c \
                   $(HLE_DIR)/vita_main.c
HLE_OBJS        := $(patsubst $(HLE_DIR)/%.c,$(BUILD_DIR)/hle_%.o,$(HLE_SRCS))

COMMON_OBJS     := $(BUILD_DIR)/recomp_functab.o \
                   $(BUILD_DIR)/runtime.o \
                   $(BUILD_DIR)/hook_stubs.o

ALL_OBJS        := $(RECOMP_OBJS) $(COMMON_OBJS) $(HLE_OBJS)

ELF             := $(BUILD_DIR)/$(TARGET).elf
VELF            := $(BUILD_DIR)/$(TARGET).velf
EBOOT           := $(BUILD_DIR)/eboot.bin
PARAM_SFO       := $(BUILD_DIR)/param.sfo
VPK             := $(BUILD_DIR)/Rayman2_Recomp.vpk

ICON0           := sce_sys/icon0.png
LIVEAREA_BG     := sce_sys/livearea/contents/bg.png
LIVEAREA_START  := sce_sys/livearea/contents/startup.png
LIVEAREA_XML    := sce_sys/livearea/contents/template.xml
PIC0            := sce_sys/pic0.png
DC_IMAGE        := assets/dc/1ST_READ.BIN

.PHONY: all clean stubs vpk elf velf eboot

all: $(VPK)

stubs: $(BUILD_DIR)/rename.sed $(BUILD_DIR)/hook_stubs.c

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/rename.sed: $(HLE_DIR)/mkstubs.py $(HGEN)/recomp_decls.h | $(BUILD_DIR)
	cd $(RECOMP_DIR) && python3 hle/mkstubs.py gen_fix
	cp $(RECOMP_DIR)/build_hle/rename.sed $(BUILD_DIR)/rename.sed
	cp $(RECOMP_DIR)/build_hle/hook_stubs.c $(BUILD_DIR)/hook_stubs.c

$(BUILD_DIR)/hook_stubs.c: $(BUILD_DIR)/rename.sed
	@true

$(BUILD_DIR)/recomp_%.o: $(HGEN)/recomp_%.c $(RECOMP_DIR)/runtime.h $(HGEN)/recomp_decls.h $(HLE_DIR)/enter.h $(BUILD_DIR)/rename.sed $(HOT_LIST) $(HLE_DIR)/coldmark.py | $(BUILD_DIR)
	sed -E -f $(BUILD_DIR)/rename.sed $< | $(COLD_FILTER) | $(CC) $(CFLAGS) -include $(HLE_DIR)/enter.h -x c - -c -o $@

$(BUILD_DIR)/recomp_functab.o: $(HGEN)/recomp_functab.c $(RECOMP_DIR)/runtime.h $(HGEN)/recomp_decls.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/runtime.o: $(RECOMP_DIR)/runtime.c $(RECOMP_DIR)/runtime.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) -Dsh4_pref=sh4_pref_default -c $< -o $@

$(BUILD_DIR)/hook_stubs.o: $(BUILD_DIR)/hook_stubs.c $(HLE_DIR)/hle.h $(HLE_DIR)/hle_priv.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/hle_%.o: $(HLE_DIR)/%.c $(HLE_DIR)/hle.h $(HLE_DIR)/hle_priv.h $(RECOMP_DIR)/runtime.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(ELF): $(ALL_OBJS) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(LDFLAGS) $^ $(LIBS) -o $@

$(VELF): $(ELF)
	$(VITA_ELF_CREATE) $< $@

$(EBOOT): $(VELF)
	$(VITA_MAKE_FSELF) -c -s $< $@

$(PARAM_SFO): | $(BUILD_DIR)
	$(VITA_MKSFOEX) -s TITLE_ID=$(TITLE_ID) -s APP_VER=$(APP_VER) $(APP_TITLE) $@

$(VPK): $(EBOOT) $(PARAM_SFO) $(ICON0) $(LIVEAREA_BG) $(LIVEAREA_START) $(LIVEAREA_XML) $(DC_IMAGE) $(wildcard $(PIC0)) | $(BUILD_DIR)
	$(VITA_PACK_VPK) -s $(PARAM_SFO) -b $(EBOOT) \
		-a $(ICON0)=sce_sys/icon0.png \
		-a $(LIVEAREA_BG)=sce_sys/livearea/contents/bg.png \
		-a $(LIVEAREA_START)=sce_sys/livearea/contents/startup.png \
		-a $(LIVEAREA_XML)=sce_sys/livearea/contents/template.xml \
		$(if $(wildcard $(PIC0)),-a $(PIC0)=sce_sys/pic0.png) \
		-a $(DC_IMAGE)=1ST_READ.BIN \
		$@
	@echo "=========================================================="
	@echo "SUCCESS: Built $(VPK)"
	@echo "=========================================================="

clean:
	rm -rf $(BUILD_DIR)
