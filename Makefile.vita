# ==============================================================================
# Rayman 2: The Great Escape — PS Vita Port (Dreamcast SH-4 Recompilation)
# ==============================================================================

VITASDK         ?= $(abspath .vitasdk)
CC              := $(VITASDK)/bin/arm-vita-eabi-gcc
CXX             := $(VITASDK)/bin/arm-vita-eabi-g++
VITA_ELF_CREATE := $(VITASDK)/bin/vita-elf-create
VITA_MAKE_FSELF := $(VITASDK)/bin/vita-make-fself
VITA_MKSFOEX    := $(VITASDK)/bin/vita-mksfoex
VITA_PACK_VPK   := $(VITASDK)/bin/vita-pack-vpk

TARGET          := rayman2_recomp
TITLE_ID        := RAYM00002
APP_TITLE       := "Rayman 2: The Great Escape (DC Recomp)"
APP_VER         := 01.00

BUILD_DIR       := build_vita
RECOMP_DIR      := tools/sh4recomp
CPA_DIR         := src/cpa
HGEN            := $(RECOMP_DIR)/gen_fix
HLE_DIR         := $(RECOMP_DIR)/hle

# EXTRA_CFLAGS: e.g. EXTRA_CFLAGS=-fstack-usage to measure recompiled frame sizes.
# -ffunction-sections/--gc-sections drops unused generated functions; -fno-strict-aliasing is needed by the guest-memory casts.
# OPT: -O3 + -fno-math-errno (sqrtf -> single vsqrt.f32 instead of the errno-setting newlib wrapper). Deliberately NOT -funsafe-math-optimizations/-ffast-math: they allow
# reassociation, reciprocal-division and NEON float vectorisation (NEON ignores FPSCR RMode and always flushes), which would change the bit-exact SH-4 FPU semantics.
# OPT_HOT: flags for everything that is not cold. OPT_COLD=cold (default) marks guest functions that never ran in the profiled host scenes (re_analysis/dc/hot_funcs.txt, ~60% of the 5705
# lifted functions) with GCC's cold attribute (optimised for size, placed in .text.unlikely) via hle/coldmark.py; OPT_COLD=none compiles everything with OPT_HOT; OPT_COLD=<attribute text>
# passes that attribute instead. Whole-program variants: OPT_HOT="-Os ..." / "-O2 ...". Text sizes of the variants: re_analysis/dc/notes_perf_cpu2.md.
# ------------------------------------------------------------------------------
# VARIANTS (performance experiments, see re_analysis/dc/notes_perf_variants.md):
#   make -f Makefile.vita VARIANT=<name> BUILD_DIR=build_vita_var<N>
# Each variant only sets V_* knobs below; anything given on the command line (OPT_HOT=..., EXTRA_CFLAGS=...) still wins. The variant name and the exact flags are compiled into
# the binary (build_dir/variant.c) and printed as the first "[vita] variant:" line of rayman2.log and in every [perf] block, so pasted logs identify themselves.
# ------------------------------------------------------------------------------
VARIANT         ?= v0_base
V_OPT_HOT       :=
V_OPT_COLD      :=
V_DEFS          :=
V_ORDER         ?= 1
OS_COLD         := __attribute__((cold,optimize("Os")))
ifeq ($(VARIANT),v0_base)
V_DEFS          := -DR2_FASTCHK_SUB
else ifeq ($(VARIANT),v1_noaudio)
V_DEFS          := -DR2_AUDIO_MODE=1
else ifeq ($(VARIANT),v1b_armonly)
V_DEFS          := -DR2_AUDIO_MODE=2
else ifeq ($(VARIANT),v2a_cpu_any)
V_DEFS          := -DR2_GAME_CPU=0 -DR2_AUDIO_CPU=0
else ifeq ($(VARIANT),v2b_cpu_shared1)
V_DEFS          := -DR2_GAME_CPU=SCE_KERNEL_CPU_MASK_USER_1 -DR2_AUDIO_CPU=SCE_KERNEL_CPU_MASK_USER_1
else ifeq ($(VARIANT),v2c_cpu_g2a1)
V_DEFS          := -DR2_GAME_CPU=SCE_KERNEL_CPU_MASK_USER_2 -DR2_AUDIO_CPU=SCE_KERNEL_CPU_MASK_USER_1
else ifeq ($(VARIANT),v2d_cpu_g1a0)
V_DEFS          := -DR2_GAME_CPU=SCE_KERNEL_CPU_MASK_USER_1 -DR2_AUDIO_CPU=SCE_KERNEL_CPU_MASK_USER_0
else ifeq ($(VARIANT),v3a_O3_all)
V_OPT_COLD      := none
else ifeq ($(VARIANT),v3b_Os_all)
V_DEFS          := -DR2_LAYOUT_PAD=20480
V_OPT_HOT       := -Os -fno-math-errno -fomit-frame-pointer
V_OPT_COLD      := none
else ifeq ($(VARIANT),v3c_O2_oscold)
V_OPT_HOT       := -O2 -fno-math-errno -fomit-frame-pointer
V_OPT_COLD      := $(OS_COLD)
else ifeq ($(VARIANT),v3d_O3_oscold)
V_OPT_COLD      := $(OS_COLD)
else ifeq ($(VARIANT),v3e_O3_packed)
V_ORDER         := 1
else ifeq ($(VARIANT),v3f_O2_oscold_packed)
V_OPT_HOT       := -O2 -fno-math-errno -fomit-frame-pointer
V_OPT_COLD      := $(OS_COLD)
V_ORDER         := 1
else ifeq ($(VARIANT),v4_subcheck)
V_DEFS          := -DR2_FASTCHK_SUB
else ifeq ($(VARIANT),v9_prof)
V_DEFS          := -DR2_PROF=1
else ifeq ($(VARIANT),v10_lean)
V_DEFS          := -DR2_PERF=0
else ifeq ($(VARIANT),v5_scale75)
V_DEFS          := -DR2_INTERNAL_SCALE=75
else
$(error unknown VARIANT '$(VARIANT)': see Makefile.vita / re_analysis/dc/notes_perf_variants.md)
endif

OPT_HOT         ?= $(if $(V_OPT_HOT),$(V_OPT_HOT),-O3 -fno-math-errno -fomit-frame-pointer)
OPT_COLD        ?= $(if $(V_OPT_COLD),$(V_OPT_COLD),none)
OPT             ?= $(OPT_HOT)
HOT_LIST        ?= re_analysis/dc/hot_funcs.txt
ifeq ($(OPT_COLD),none)
COLD_FILTER     := cat
else ifeq ($(OPT_COLD),cold)
COLD_FILTER     := python3 $(HLE_DIR)/coldmark.py $(HOT_LIST)
else
COLD_FILTER     := python3 $(HLE_DIR)/coldmark.py $(HOT_LIST) '$(OPT_COLD)'
endif

# Render thread (R2_RENDER_THREAD): 1 (default) = dedicated GL thread; 0 = inline on game thread
RENDER_THREAD   ?= 1
ifeq ($(RENDER_THREAD),0)
V_DEFS          += -DR2_RENDER_THREAD=0
endif
# HD texture staging test switch: HD_STAGE_SYNC=1 disables the stager worker thread (loads run on the game thread)
HD_STAGE_SYNC   ?= 0
ifeq ($(HD_STAGE_SYNC),1)
V_DEFS          += -DCPA_HD_STAGE_SYNC
endif
# HD texture test switch: HD_GPU_NOFREE=1 keeps the copied DXT chains alive (never freed)
HD_GPU_NOFREE   ?= 0
ifeq ($(HD_GPU_NOFREE),1)
V_DEFS          += -DR2_HD_GPU_MEM_NOFREE
endif
# HD texture test switch: HD_FORCE_RGBA=1 expands DXT overrides to RGBA before upload (no compressed uploads)
HD_FORCE_RGBA   ?= 0
ifeq ($(HD_FORCE_RGBA),1)
V_DEFS          += -DCPA_HD_FORCE_RGBA
endif

CFLAGS          := $(OPT) -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard \
                   -fno-strict-aliasing -ffunction-sections -fdata-sections \
                   $(V_DEFS) $(EXTRA_CFLAGS) \
                   -Wall -Wextra -Wno-unused-parameter -Wno-unused-variable -Wno-unused-label \
                   -DCPA_PLATFORM_VITA -DR2_DREAMCAST_BASELINE -D__vita__ \
                   -I$(RECOMP_DIR) -I$(HGEN) -I$(HLE_DIR) -Iinclude -Isrc/platform/vita

LDFLAGS         := -Wl,-q -Wl,--gc-sections -Wl,--defsym,__sce_headroom=0x20000 -L$(VITASDK)/arm-vita-eabi/lib
# V_ORDER=1 (variants *_packed): a linker script (default script + hot list, hotorder.py) puts the .text.f_<addr> sections of the profiled hot functions (hot_funcs.txt, most-called first) contiguously at the
# start of .text, so the hot set occupies ~1/3 of the pages / cache sets it is otherwise spread over (the lifter emits functions in address order; hot and cold interleave).
HOT_ORDER       := $(BUILD_DIR)/hot_order.ld
ifeq ($(V_ORDER),1)
LDFLAGS         += -Wl,-T,$(HOT_ORDER)
endif

# PROFILE=1: per-frame split of GL submit / swap / TA SQ parse time in the [vita] log line (costs two timer reads per TA write).
ifeq ($(PROFILE),1)
CFLAGS  += -DR2_VITA_PROFILE
LDFLAGS += -Wl,--wrap,vita_gl_render_frame -Wl,--wrap,vita_gl_swap -Wl,--wrap,ta_ext_write32 -Wl,--wrap,sceClibMspaceRealloc
endif

LIBS            := -lvitaGL \
                   -lvitashark \
                   -lSceShaccCgExt \
                   -lSceShaccCg_stub \
                   -ltaihen_stub \
                   -lSceGxm_stub \
                   -lSceDisplay_stub \
                   -lSceCtrl_stub \
                   -lSceKernelDmacMgr_stub \
                   -lSceCommonDialog_stub \
                   -lSceAppMgr_stub \
                   -lSceLibKernel_stub \
                   -lSceKernelThreadMgr_stub \
                   -lSceIofilemgr_stub \
                   -lSceAudio_stub \
                   -lScePower_stub \
                   -lmathneon \
                   -lstdc++ \
                   -lm

# VitaDebugger support (make DEBUGGER=1)
DEBUGGER        ?= 1
ifeq ($(DEBUGGER),1)
CFLAGS          += -DR2_USE_VITADEBUGGER
LIBS            += -luvdb -lkubridge_stub -lSceNet_stub -lSceNetPs_stub -lSceNetCtl_stub -lSceKernelModulemgr_stub -pthread
endif

# Audio module: cleanroom audio engine (0 = fallback to AICA emulator snd.c, 1 = cleanroom audio)
USE_CLEANROOM_AUDIO ?= 0
ifeq ($(USE_CLEANROOM_AUDIO),1)
SND_SRC         ?= $(HLE_DIR)/snd_cleanroom.c
EXTRA_OBJS      += $(BUILD_DIR)/snd_vita.o
else
SND_SRC         ?= $(wildcard $(HLE_DIR)/snd.c)
endif

# NATIVE renderer (src/cpa + cpa_gl_backend): linked in by default, active only when the empty file ux0:data/rayman2/NATIVE_GFX exists (NATIVE_GFX=0 at build time leaves it out entirely)
.DEFAULT_GOAL  := all
NATIVE_GFX      ?= 1
ifeq ($(NATIVE_GFX),1)
CFLAGS          += -DR2_NATIVE_GFX -I$(CPA_DIR)
# cpa_light.c is #included by cpa_scene.c
CPA_SRCS        := image scene vis anim render hud tex camera drawlist
NATIVE_OBJS     := $(patsubst %,$(BUILD_DIR)/cpa_%.o,$(CPA_SRCS)) $(BUILD_DIR)/cpa_gl_backend.o $(BUILD_DIR)/hle_native_hook.o
EXTRA_OBJS      += $(NATIVE_OBJS)
$(BUILD_DIR)/cpa_%.o: $(CPA_DIR)/cpa_%.c $(wildcard $(CPA_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD_DIR)/cpa_gl_backend.o: src/platform/vita/cpa_gl_backend.c $(wildcard $(CPA_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
endif

# Generated recompilation translation units
RECOMP_SRCS     := $(wildcard $(HGEN)/recomp_[0-9]*.c)
RECOMP_OBJS     := $(patsubst $(HGEN)/recomp_%.c,$(BUILD_DIR)/recomp_%.o,$(RECOMP_SRCS))

# HLE & Runtime Sources
HLE_SRCS        := $(HLE_DIR)/boot.c \
                   $(HLE_DIR)/camera.c \
                   $(HLE_DIR)/dbg.c \
                   $(HLE_DIR)/io.c \
                   $(HLE_DIR)/mathhooks.c \
                   $(HLE_DIR)/geomhooks.c \
                   $(HLE_DIR)/nativecut.c \
                   $(HLE_DIR)/pad.c \
                   $(HLE_DIR)/perf.c \
                   $(HLE_DIR)/r2prof.c \
                   $(HLE_DIR)/ta.c \
                   $(HLE_DIR)/ta_hle.c \
                   $(SND_SRC) \
                   $(HLE_DIR)/texmap.c \
                   $(HLE_DIR)/vita_gl_render.c \
                   $(HLE_DIR)/vita_main.c \
                   $(if $(filter 0,$(USE_VMU)),,$(HLE_DIR)/vmu.c)
HLE_OBJS        := $(patsubst $(HLE_DIR)/%.c,$(BUILD_DIR)/hle_%.o,$(HLE_SRCS))

COMMON_OBJS     := $(BUILD_DIR)/recomp_functab.o \
                   $(BUILD_DIR)/runtime.o \
                   $(BUILD_DIR)/hook_stubs.o

COMMON_OBJS     += $(BUILD_DIR)/variant.o $(BUILD_DIR)/cpa_hd_tex.o $(BUILD_DIR)/cpa_hd_manifest.o $(BUILD_DIR)/cpa_hd_pak.o $(BUILD_DIR)/cpa_hd_stage.o
ALL_OBJS        := $(RECOMP_OBJS) $(COMMON_OBJS) $(HLE_OBJS) $(EXTRA_OBJS)

ELF             := $(BUILD_DIR)/$(TARGET).elf
VELF            := $(BUILD_DIR)/$(TARGET).velf
EBOOT           := $(BUILD_DIR)/eboot.bin
PARAM_SFO       := $(BUILD_DIR)/param.sfo
VPK             := $(BUILD_DIR)/Rayman2_Recomp.vpk

ICON0           := sce_sys/icon0.png
LIVEAREA_BG     := sce_sys/livearea/contents/bg.png
LIVEAREA_START  := sce_sys/livearea/contents/startup.png
LIVEAREA_XML    := sce_sys/livearea/contents/template.xml
PIC0            := sce_sys/pic0.png
DC_IMAGE        := assets/dc/1ST_READ.BIN

.PHONY: all clean stubs vpk elf velf eboot

all: $(VPK)

vpk: $(VPK)
elf: $(ELF)
velf: $(VELF)
eboot: $(EBOOT)

stubs: $(BUILD_DIR)/rename.sed $(BUILD_DIR)/hook_stubs.c

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# variant.c: name + flags of this build (rewritten only when the text changes, so make stays quiet); linked into the binary and logged by vita_main.c / perf.c
VARIANT_FLAGS   := OPT_HOT=[$(OPT_HOT)] OPT_COLD=[$(OPT_COLD)] V_DEFS=[$(V_DEFS)] EXTRA_CFLAGS=[$(EXTRA_CFLAGS)] ORDER=$(if $(V_ORDER),hot-first,none) PROFILE=$(PROFILE) AUDIO=$(if $(filter 1,$(USE_CLEANROOM_AUDIO)),cleanroom,aica)
VAR_ESC         = $(subst ",\",$(subst \,\\,$(1)))
.PHONY: FORCE
FORCE:
$(BUILD_DIR)/variant.c: FORCE | $(BUILD_DIR)
	@printf 'const char r2_variant_name[] = "%s";\nconst char r2_variant_flags[] = "%s";\n' '$(call VAR_ESC,$(VARIANT))' '$(call VAR_ESC,$(VARIANT_FLAGS))' > $@.new; \
	  if cmp -s $@.new $@; then rm -f $@.new; else mv $@.new $@; fi
$(BUILD_DIR)/variant.o: $(BUILD_DIR)/variant.c
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD_DIR)/cpa_hd_tex.o: $(CPA_DIR)/cpa_hd_tex.c $(wildcard $(CPA_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD_DIR)/cpa_hd_manifest.o: $(CPA_DIR)/cpa_hd_manifest.c $(wildcard $(CPA_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD_DIR)/cpa_hd_pak.o: $(CPA_DIR)/cpa_hd_pak.c $(wildcard $(CPA_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD_DIR)/cpa_hd_stage.o: $(CPA_DIR)/cpa_hd_stage.c $(wildcard $(CPA_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
$(HOT_ORDER): $(HOT_LIST) $(HLE_DIR)/hotorder.py | $(BUILD_DIR)
	$(CC) -x c /dev/null -Wl,--verbose -nostartfiles -nostdlib -o /dev/null 2>/dev/null | sed -n '/^======/,/^======/p' | sed '1d;$$d' | python3 $(HLE_DIR)/hotorder.py $(HOT_LIST) > $@

# the hookable set is every guest address literal in hle/*.c|h (mkstubs.py): rename.sed must be regenerated when any of them changes, otherwise a newly added native hook is never routed through its stub
$(BUILD_DIR)/rename.sed: $(HLE_DIR)/mkstubs.py $(HGEN)/recomp_decls.h $(wildcard $(HLE_DIR)/*.c) $(wildcard $(HLE_DIR)/*.h) | $(BUILD_DIR)
	cd $(RECOMP_DIR) && python3 hle/mkstubs.py gen_fix
	cp $(RECOMP_DIR)/build_hle/rename.sed $(BUILD_DIR)/rename.sed
	cp $(RECOMP_DIR)/build_hle/hook_stubs.c $(BUILD_DIR)/hook_stubs.c

$(BUILD_DIR)/hook_stubs.c: $(BUILD_DIR)/rename.sed
	@true

$(BUILD_DIR)/recomp_%.o: $(HGEN)/recomp_%.c $(RECOMP_DIR)/runtime.h $(HGEN)/recomp_decls.h $(HLE_DIR)/enter.h $(BUILD_DIR)/rename.sed $(HOT_LIST) $(HLE_DIR)/coldmark.py | $(BUILD_DIR)
	sed -E -f $(BUILD_DIR)/rename.sed $< | $(COLD_FILTER) | $(CC) $(CFLAGS) -include $(HLE_DIR)/enter.h -x c - -c -o $@

$(BUILD_DIR)/recomp_functab.o: $(HGEN)/recomp_functab.c $(RECOMP_DIR)/runtime.h $(HGEN)/recomp_decls.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/runtime.o: $(RECOMP_DIR)/runtime.c $(RECOMP_DIR)/runtime.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) -Dsh4_pref=sh4_pref_default -c $< -o $@

$(BUILD_DIR)/hook_stubs.o: $(BUILD_DIR)/hook_stubs.c $(HLE_DIR)/hle.h $(HLE_DIR)/hle_priv.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/hle_%.o: $(HLE_DIR)/%.c $(HLE_DIR)/hle.h $(HLE_DIR)/hle_priv.h $(RECOMP_DIR)/runtime.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/snd_vita.o: src/platform/vita/snd_vita.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
$(ELF): $(ALL_OBJS) $(if $(V_ORDER),$(HOT_ORDER)) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(LDFLAGS) $(filter-out %.ld,$^) $(LIBS) -o $@

$(VELF): $(ELF)
	$(VITA_ELF_CREATE) $< $@

$(EBOOT): $(VELF)
	$(VITA_MAKE_FSELF) -c -s $< $@

$(PARAM_SFO): | $(BUILD_DIR)
	$(VITA_MKSFOEX) -s TITLE_ID=$(TITLE_ID) -s APP_VER=$(APP_VER) $(APP_TITLE) $@

$(VPK): $(EBOOT) $(PARAM_SFO) $(ICON0) $(LIVEAREA_BG) $(LIVEAREA_START) $(LIVEAREA_XML) $(DC_IMAGE) $(wildcard $(PIC0)) | $(BUILD_DIR)
	$(VITA_PACK_VPK) -s $(PARAM_SFO) -b $(EBOOT) \
		-a $(ICON0)=sce_sys/icon0.png \
		-a $(LIVEAREA_BG)=sce_sys/livearea/contents/bg.png \
		-a $(LIVEAREA_START)=sce_sys/livearea/contents/startup.png \
		-a $(LIVEAREA_XML)=sce_sys/livearea/contents/template.xml \
		$(if $(wildcard $(PIC0)),-a $(PIC0)=sce_sys/pic0.png) \
		-a $(DC_IMAGE)=1ST_READ.BIN \
		$@
	@echo "=========================================================="
	@echo "SUCCESS: Built $(VPK)"
	@echo "=========================================================="

clean:
	rm -rf $(BUILD_DIR)
